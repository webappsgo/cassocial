# =============================================================================
# Development Build Stage - Compile Go binary
# =============================================================================
FROM casjaysdev/go:latest AS builder

RUN apk upgrade --no-cache && apk add --no-cache git bash

ARG TARGETARCH
ARG VERSION=devel
ARG BUILD_EPOCH=0
ARG COMMIT_ID
ARG OFFICIAL_SITE=

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOFLAGS=-buildvcs=false go build \
    -trimpath \
    -ldflags "-s -w -X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE}'" \
    -o /build/binary/cassocial ./src

# =============================================================================
# Development Runtime Stage
# =============================================================================
FROM alpine:latest

ARG BUILD_DATE
ARG COMMIT_ID

RUN apk add --no-cache \
    git \
    curl \
    bash \
    tini \
    tor \
    i2pd \
    tzdata \
    ca-certificates

COPY --from=builder /build/binary/cassocial /usr/local/bin/cassocial
COPY docker/rootfs/ /
COPY docker/Dockerfile.dev /root/Dockerfile
RUN chmod 755 /usr/local/bin/*

ENV MODE=development \
    TZ=America/New_York \
    DATABASE_DIR=/data/db/sqlite

EXPOSE 80

STOPSIGNAL SIGRTMIN+3

HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 \
    CMD /usr/local/bin/cassocial --status || exit 1

ENTRYPOINT [ "tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh" ]
