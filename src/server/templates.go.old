package server

import (
	"embed"
	"fmt"
	"html/template"
	"net/http"
	"strings"
	"sync"
	"time"
)

// TemplateManager manages HTML templates
type TemplateManager struct {
	mu        sync.RWMutex
	templates map[string]*template.Template
	funcMap   template.FuncMap
	fs        embed.FS
}

// NewTemplateManager creates a new template manager
func NewTemplateManager(templateFS embed.FS) (*TemplateManager, error) {
	tm := &TemplateManager{
		templates: make(map[string]*template.Template),
		fs:        templateFS,
		funcMap: template.FuncMap{
			"formatDate":     formatDate,
			"formatDateTime": formatDateTime,
			"formatTime":     formatTime,
			"formatNumber":   formatNumber,
			"truncate":       truncate,
			"lower":          strings.ToLower,
			"upper":          strings.ToUpper,
			"title":          strings.Title,
			"contains":       strings.Contains,
			"hasPrefix":      strings.HasPrefix,
			"hasSuffix":      strings.HasSuffix,
			"join":           strings.Join,
			"split":          strings.Split,
			"replace":        strings.ReplaceAll,
			"safeHTML":       safeHTML,
			"safeCSS":        safeCSS,
			"safeURL":        safeURL,
			"dict":           dict,
			"list":           list,
			"add":            add,
			"sub":            sub,
			"mul":            mul,
			"div":            div,
			"mod":            mod,
			"eq":             eq,
			"ne":             ne,
			"lt":             lt,
			"le":             le,
			"gt":             gt,
			"ge":             ge,
		},
	}

	// Load all templates
	if err := tm.loadTemplates(); err != nil {
		return nil, err
	}

	return tm, nil
}

// loadTemplates loads all HTML templates from the embedded filesystem
func (tm *TemplateManager) loadTemplates() error {
	// For now, just create placeholder templates
	// In a full implementation, templates would be embedded at build time

	// Create a simple default template
	defaultTmpl := template.Must(template.New("default").Funcs(tm.funcMap).Parse(`
<!DOCTYPE html>
<html>
<head>
    <title>{{.Title}}</title>
</head>
<body>
    <h1>{{.Title}}</h1>
    <p>Template system initialized. Templates will be loaded from embedded filesystem.</p>
</body>
</html>
`))

	tm.mu.Lock()
	tm.templates["default.html"] = defaultTmpl
	tm.templates["index.html"] = defaultTmpl
	tm.templates["maintenance.html"] = defaultTmpl
	tm.mu.Unlock()

	return nil
}

// Render renders a template with the given data
func (tm *TemplateManager) Render(w http.ResponseWriter, name string, data interface{}) error {
	tm.mu.RLock()
	tmpl, exists := tm.templates[name]
	tm.mu.RUnlock()

	if !exists {
		http.Error(w, fmt.Sprintf("Template %s not found", name), http.StatusInternalServerError)
		return fmt.Errorf("template not found: %s", name)
	}

	// Set content type
	w.Header().Set("Content-Type", "text/html; charset=utf-8")

	// Execute template
	if err := tmpl.Execute(w, data); err != nil {
		http.Error(w, "Internal Server Error", http.StatusInternalServerError)
		return fmt.Errorf("template execution failed: %w", err)
	}

	return nil
}

// Reload reloads all templates (useful for development)
func (tm *TemplateManager) Reload() error {
	tm.mu.Lock()
	defer tm.mu.Unlock()

	tm.templates = make(map[string]*template.Template)
	return tm.loadTemplates()
}

// Template helper functions

// formatDate formats a time as a date string
func formatDate(t time.Time) string {
	return t.Format("2006-01-02")
}

// formatDateTime formats a time as a datetime string
func formatDateTime(t time.Time) string {
	return t.Format("2006-01-02 15:04:05")
}

// formatTime formats a time as a time string
func formatTime(t time.Time) string {
	return t.Format("15:04:05")
}

// formatNumber formats a number with thousand separators
func formatNumber(n interface{}) string {
	var num int
	switch v := n.(type) {
	case int:
		num = v
	case int64:
		num = int(v)
	case int32:
		num = int(v)
	default:
		return fmt.Sprintf("%v", n)
	}

	// Simple thousand separator
	str := fmt.Sprintf("%d", num)
	if len(str) <= 3 {
		return str
	}

	var result []rune
	for i, r := range str {
		if i > 0 && (len(str)-i)%3 == 0 {
			result = append(result, ',')
		}
		result = append(result, r)
	}

	return string(result)
}

// truncate truncates a string to a maximum length
func truncate(s string, length int) string {
	if len(s) <= length {
		return s
	}
	return s[:length] + "..."
}

// safeHTML returns the string as HTML without escaping
func safeHTML(s string) template.HTML {
	return template.HTML(s)
}

// safeCSS returns the string as CSS without escaping
func safeCSS(s string) template.CSS {
	return template.CSS(s)
}

// safeURL returns the string as a URL without escaping
func safeURL(s string) template.URL {
	return template.URL(s)
}

// dict creates a map from key-value pairs
func dict(values ...interface{}) (map[string]interface{}, error) {
	if len(values)%2 != 0 {
		return nil, fmt.Errorf("dict requires an even number of arguments")
	}

	dict := make(map[string]interface{}, len(values)/2)
	for i := 0; i < len(values); i += 2 {
		key, ok := values[i].(string)
		if !ok {
			return nil, fmt.Errorf("dict keys must be strings")
		}
		dict[key] = values[i+1]
	}

	return dict, nil
}

// list creates a slice from arguments
func list(values ...interface{}) []interface{} {
	return values
}

// Math functions
func add(a, b int) int {
	return a + b
}

func sub(a, b int) int {
	return a - b
}

func mul(a, b int) int {
	return a * b
}

func div(a, b int) int {
	if b == 0 {
		return 0
	}
	return a / b
}

func mod(a, b int) int {
	if b == 0 {
		return 0
	}
	return a % b
}

// Comparison functions
func eq(a, b interface{}) bool {
	return a == b
}

func ne(a, b interface{}) bool {
	return a != b
}

func lt(a, b int) bool {
	return a < b
}

func le(a, b int) bool {
	return a <= b
}

func gt(a, b int) bool {
	return a > b
}

func ge(a, b int) bool {
	return a >= b
}

// Common template data structures

// PageData represents common page data
type PageData struct {
	Title       string
	Description string
	Keywords    string
	Theme       string
	User        *UserData
	Flash       *FlashMessage
	CSRF        string
	Meta        map[string]interface{}
}

// UserData represents user data for templates
type UserData struct {
	ID            string
	Username      string
	Email         string
	Role          string
	EmailVerified bool
	Avatar        string
}

// FlashMessage represents a flash message
type FlashMessage struct {
	Type    string // success, error, warning, info
	Message string
}

// SetFlash sets a flash message in the session
func SetFlash(w http.ResponseWriter, flashType, message string) {
	// TODO: Implement flash message storage in session
	// For now, set as cookie
	http.SetCookie(w, &http.Cookie{
		Name:     "flash",
		Value:    fmt.Sprintf("%s:%s", flashType, message),
		Path:     "/",
		MaxAge:   1,
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
	})
}

// GetFlash retrieves and clears a flash message from the session
func GetFlash(r *http.Request) *FlashMessage {
	cookie, err := r.Cookie("flash")
	if err != nil {
		return nil
	}

	parts := strings.SplitN(cookie.Value, ":", 2)
	if len(parts) != 2 {
		return nil
	}

	return &FlashMessage{
		Type:    parts[0],
		Message: parts[1],
	}
}
